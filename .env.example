# Copy this file to .env and fill in your own values.
# Monitoring only by default. Never commit .env or real credentials.

POLYGON_WSS=
POLYGON_HTTP=
WATCH_WALLET=
PROXY_URL=http://127.0.0.1:7890
UI_PORT=3001
UI_HOST=127.0.0.1
UI_SECRET=

# Network/request stability
FETCH_TIMEOUT_MS=30000
DISCOVERY_ANALYZE_TIMEOUT_MS=15000
DISCOVERY_LEADERBOARD_TIMEOUT_MS=30000
DISCOVERY_CONCURRENCY=1

# Optional QQ Bot
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQBOT_TARGET_TYPE=c2c
QQBOT_TARGET_ID=
QQ_SANDBOX=false

# CLOB credentials are intentionally blank.
PM_PRIVATE_KEY=
PM_FUNDER_ADDRESS=
PM_SIGNATURE_TYPE=1
PM_API_KEY=
PM_API_SECRET=
PM_API_PASSPHRASE=
PM_CHAIN_ID=137
PM_CLOB_HOST=https://clob.polymarket.com

# Trading must remain disabled until explicitly configured and tested.
AUTO_TRADE_ENABLED=false
AUTO_TRADE_MODE=paper
AUTO_TRADE_DRY_RUN=true
AUTO_TRADE_ALLOW_LIVE_AUTO=false
AUTO_TRADE_LIVE_TEST_ENABLED=false
AUTO_TRADE_USD_PER_ORDER=1
AUTO_TRADE_MAX_ORDER_USD=5
AUTO_TRADE_DAILY_MAX_USD=10
AUTO_TRADE_DUPLICATE_COOLDOWN_MS=60000
KILL_SWITCH=true

# BTC 5-minute analysis is opt-in; AI credentials are blank.
BTC5M_ENABLED=false
BTC5M_AI_BASE_URL=
BTC5M_AI_API_KEY=
BTC5M_AI_MODEL=
BTC5M_DEFAULT_TRADE_USD=1
